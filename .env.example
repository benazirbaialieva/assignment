# Copy to .env and adjust. Real environment variables always win over this file.

# Which environment profile to start from: local | ci | staging
TEST_ENV=local

# Applications under test
BASE_URL=http://127.0.0.1:5173
API_BASE_URL=http://127.0.0.1:4000

# Credentials
API_KEY=test-api-key
ADMIN_TOKEN=admin-token

# Browser
BROWSER_CHANNEL=chrome
HEADLESS=false
SLOW_MO=250
STEP_TIMEOUT_MS=30000

# Reporting and logging
REPORTS_DIR=reports
LOG_API=true
LOG_UI=true
LOG_LEVEL=debug          # debug | info | warn | error
LOG_TO_CONSOLE=true      # stream the log to the terminal as the run goes
SCREENSHOT_ON_FAILURE=true
TRACE=false              # record a Playwright trace, kept when a UI scenario fails
